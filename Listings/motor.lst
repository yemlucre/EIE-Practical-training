  75          void T0isp() interrupt 1
  76          {
  77   1              unsigned char i,j;
  78   1              TL0 = (65536-200)%256;          
  79   1              TH0 = (65536-200)/256;          
  80   1              i++;
  81   1              j++;
  82   1              if(i < PWMA)
  83   1              {
  84   2                      ENA = 1;
  85   2              }
  86   1              else 
  87   1              {
  88   2                      ENA = 0;
  89   2                      if(i >= 100)
  90   2                      {
  91   3                              i = 0;
  92   3                      }
  93   2              }
  94   1              if(j < PWMB)
  95   1              {
  96   2                      ENB = 1;
  97   2              }
  98   1              else 
  99   1              {
 100   2                      ENB = 0;
 101   2                      if(j >= 100)
 102   2                      {
 103   3                              j = 0;
 104   3                      }
 105   2              }
 106   1      }
